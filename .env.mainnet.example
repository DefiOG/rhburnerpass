# RHBurnerPass MAINNET deployment template.
# Copy to .env.mainnet locally. .env.mainnet is gitignored.
# NEVER commit or share the real deployer private key.
DEPLOYER_PRIVATE_KEY=0x...

# Production FeeVault destination. Must be a deployed contract-controlled wallet/multisig.
TREASURY_ADDRESS=0x...

# Owner of the Official Integration Registry. Must be a deployed contract-controlled wallet/multisig.
PROTOCOL_OWNER_ADDRESS=0x...

# Robinhood Chain mainnet. A production provider is preferred over the public rate-limited RPC.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deliberate mainnet safety lock. Leave blank until the final deployment review is complete.
CONFIRM_MAINNET_DEPLOY=
