# Never commit a real private key. Use a disposable TESTNET deployer only for alpha.
DEPLOYER_PRIVATE_KEY=0x...

# Fee revenue destination. Use a dedicated multisig for production.
TREASURY_ADDRESS=0x...
# Owner of the official-integration allowlist. Prefer a multisig. Defaults to deployer only in testnet helper scripts.
PROTOCOL_OWNER_ADDRESS=0x...
PROJECT_TREASURY_ADDRESS=0x...
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Protocol fee is fixed in FeeVaultV2 bytecode at exactly 0.00005 ETH per delegated NFT.
# Testnet ETH has no monetary value.
MINT_PRICE_WEI=0

# Filled after protocol + allowlist setup
RHBP_REGISTRY_ADDRESS=0x...
RHBP_FEE_VAULT_ADDRESS=0x...
RHBP_OFFICIAL_INTEGRATION_REGISTRY_ADDRESS=0x...
MERKLE_ROOT=0x...

# Frontend
VITE_RHBP_REGISTRY_ADDRESS=0x...
VITE_RHBP_FEE_VAULT_ADDRESS=0x...
VITE_RHBP_OFFICIAL_INTEGRATION_REGISTRY_ADDRESS=0x...
# Optional: enables WalletConnect/mobile QR sessions. Injected EIP-6963 wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# RHBurnerPass v2 self-service protocol (filled after v2 protocol deployment)
RHBP_V2_FACTORY_ADDRESS=0x...
RHBP_V2_REGISTRY_ADDRESS=0x...
RHBP_V2_FEE_VAULT_ADDRESS=0x...
# Mainnet-only safety confirmations (keep unset during normal development)
# CONFIRM_RHBP_V2_MAINNET=RHBURNERPASS_V2_MAINNET
# CONFIRM_RHBP_V2_MINT_MAINNET=CREATE_RHBP_V2_MINT_MAINNET
